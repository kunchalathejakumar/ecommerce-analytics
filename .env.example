# AWS credentials and region
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# S3 and Athena
S3_BUCKET=your-s3-bucket-name
ATHENA_OUTPUT_S3=s3://your-s3-bucket-name/athena-results/
# ATHENA_WORKGROUP=primary  # optional, defaults to primary

# PostgreSQL (local Docker: port 5433; inside Docker network: port 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SCHEMA_STAGING=staging
POSTGRES_SCHEMA_MARTS=marts

# Airflow
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=your_fernet_key_base64
AIRFLOW_WEBSERVER_SECRET_KEY=your_webserver_secret_key

# AWS Glue job names
GLUE_JOB_NAME_CUSTOMERS=ecommerce-customers-transform
GLUE_JOB_NAME_PRODUCTS=ecommerce-products-transform
GLUE_JOB_NAME_ORDERS=ecommerce-orders-transform
GLUE_JOB_NAME_ORDER_ITEMS=ecommerce-order-items-transform

# AWS Glue crawler names
GLUE_CRAWLER_NAME_RAW=ecommerce-raw-crawler
GLUE_CRAWLER_NAME_PROCESSED=ecommerce-processed-crawler
